{
  "name": "x402-router.wgw.lol",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "astro": "pnpm exec astro",
    "build": "pnpm run generate-public && pnpm exec cf build && pnpm run build:cf",
    "build:cf": "pnpm exec cf deploy --dry-run --prebuilt --mode production",
    "check": "ultracite fix --type-aware --type-check",
    "deploy": "pnpm exec cf deploy --prebuilt --mode production",
    "dev": "WGW_ASTRO_NO_ADAPTER=1 pnpm exec astro dev",
    "dev:cf": "pnpm run generate-public && pnpm exec cf dev",
    "generate-public": "node scripts/generate-public.mjs",
    "generate-types": "pnpm exec cf workers types",
    "preview": "pnpm exec astro preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "catalog:",
    "@astrojs/starlight": "0.42.2",
    "@tailwindcss/vite": "4.3.3",
    "@tunnckocore/x402-router": "workspace:^",
    "astro": "catalog:",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "cf": "catalog:",
    "typescript": "catalog:types"
  }
}

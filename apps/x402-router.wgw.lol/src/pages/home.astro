---
// The landing page as a sequence of short statements, one per band. The index page stays as is.
import "../styles.css";

import { CDP_FORWARD_TOKEN_HEADER } from "@tunnckocore/x402-router";

const pageTitle = "WGW x402 Router";
const pageDescription =
  "One x402 v2 facilitator URL that routes each payment to PrimeV, CDP, or x402.org by network.";
const origin = Astro.url.origin;
const sourceUrl = "https://github.com/tunnckoCoreHQ/monarch/tree/master/packages/x402-router";
const licenseUrl =
  "https://github.com/tunnckoCoreHQ/monarch/blob/master/apps/x402-router.wgw.lol/LICENSE";
const commit = import.meta.env.COMMIT_SHA;
const commitHref =
  commit === "local"
    ? "https://github.com/tunnckoCoreHQ/monarch"
    : `https://github.com/tunnckoCoreHQ/monarch/commit/${commit}`;

type Part = { text: string; tone?: "key" | "accent" | "info" };

// Unmarked words are set dimmer, so the key phrase carries the line.
const statements: { parts: Part[]; support: string }[] = [
  {
    parts: [{ text: "One URL", tone: "key" }, { text: " in your facilitator client." }],
    support:
      "Set it as the url in HTTPFacilitatorClient. The middleware calls /supported, /verify and /settle there, like any facilitator.",
  },
  {
    parts: [
      { text: "Ethereum Mainnet", tone: "key" },
      { text: " goes to " },
      { text: "PrimeV.", tone: "accent" },
    ],
    support:
      "1.2s settlement with sponsored gas, through facilitator.primev.xyz. No auth header needed.",
  },
  {
    parts: [
      { text: "Base, Polygon, Arbitrum, World Chain and Solana", tone: "key" },
      { text: " go to " },
      { text: "CDP.", tone: "info" },
    ],
    support:
      "Through api.cdp.coinbase.com, with a short-lived JWT your server signs. World Chain Sepolia routes there too.",
  },
  {
    parts: [
      { text: "Base Sepolia and Solana Devnet", tone: "key" },
      { text: " go to " },
      { text: "x402.org.", tone: "key" },
    ],
    support:
      "Public test networks, through x402.org/facilitator. No auth header needed. World Chain Sepolia goes to CDP.",
  },
  {
    parts: [
      { text: "Your " },
      { text: "CDP keys", tone: "info" },
      { text: " stay on your server.", tone: "key" },
    ],
    support: `createCdpAuthHeaders signs a short-lived JWT and sends it as ${CDP_FORWARD_TOKEN_HEADER}. The router copies it to authorization only when the route is CDP.`,
  },
  {
    parts: [{ text: "No accounts. No database. " }, { text: "Nothing stored.", tone: "key" }],
    support:
      "The router reads x402Version, scheme and network, picks the upstream, and streams back its status and body.",
  },
];

const toneClass = { key: "text-primary", accent: "text-accent", info: "text-info" } as const;

// Tiny tokenizer for the static snippet: comments, strings, keywords, x402 identifiers.
const tokenPattern =
  /((?<!:)\/\/.*$|^#.*$)|("(?:[^"\\\n]|\\.)*")|\b(import|from|const|new|export|default|async|return|await)\b|\b(createCdpAuthHeaders|createX402Router|HTTPFacilitatorClient|x402ResourceServer|paymentMiddleware|ExactEvmScheme|ExactSvmScheme)\b/gm;
const escapeHtml = (text: string) =>
  text.replace(/[&<>]/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" })[char] ?? char);
function highlight(source: string) {
  let html = "";
  let last = 0;
  for (const match of source.matchAll(tokenPattern)) {
    const index = match.index ?? 0;
    html += escapeHtml(source.slice(last, index));
    const tone = match[1]
      ? "text-secondary"
      : match[2]
        ? "text-warn"
        : match[3]
          ? "text-info"
          : "text-accent";
    html += `<span class="${tone}">${escapeHtml(match[0])}</span>`;
    last = index + match[0].length;
  }
  return html + escapeHtml(source.slice(last));
}

const sellerCode = `import { BASE_MAINNET, ETHEREUM_MAINNET, SOLANA_MAINNET } from "@tunnckocore/x402-router";
import { createCdpAuthHeaders } from "@tunnckocore/x402-router/cdp";
import { HTTPFacilitatorClient, x402ResourceServer } from "@x402/core/server";
import { ExactEvmScheme } from "@x402/evm/exact/server";
import { paymentMiddleware } from "@x402/hono";
import { ExactSvmScheme } from "@x402/svm/exact/server";
import { Hono } from "hono";

const app = new Hono();

const facilitator = new HTTPFacilitatorClient({
  url: "${origin}",
  createAuthHeaders: () =>
    createCdpAuthHeaders({
      apiKeyId: process.env.CDP_API_KEY_ID,
      apiKeySecret: process.env.CDP_API_KEY_SECRET,
    }),
});

const server = new x402ResourceServer(facilitator)
  .register(ETHEREUM_MAINNET, new ExactEvmScheme())
  .register(BASE_MAINNET, new ExactEvmScheme())
  .register(SOLANA_MAINNET, new ExactSvmScheme());

app.use(
  paymentMiddleware(
    {
      "GET /paid": {
        accepts: [{ scheme: "exact", network: ETHEREUM_MAINNET, payTo: "0xYourAddress", price: "$1" }],
        description: "Paid example endpoint",
      },
    },
    server,
  ),
);`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={Astro.url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400..600&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@700,800&f[]=general-sans@400,500,600&display=swap"
    />
  </head>
  <body class="bg-page text-primary antialiased">
    <div class="manifesto min-h-[100dvh]">
      <header class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 md:px-8">
        <a href="/home" class="flex items-center gap-2.5 font-medium tracking-tight">
          <img src="/favicon.svg" alt="" class="h-7 w-7" />
          x402-router
        </a>
        <nav class="flex items-center gap-6 text-sm text-secondary">
          <a class="hidden hover:text-primary sm:inline" href="/docs/">Docs</a>
          <a class="hidden hover:text-primary sm:inline" href="/docs/self-hosting/">Self-host</a>
          <a
            class="inline-flex items-center gap-1.5 hover:text-primary"
            href={sourceUrl}
            rel="noreferrer external"
            target="_blank"
          >
            <svg class="h-3.5 w-3.5" aria-hidden="true" viewBox="0 0 16 16" fill="currentColor">
              <path
                d="M8 0C3.58 0 0 3.67 0 8.2c0 3.62 2.29 6.69 5.47 7.77.4.08.55-.18.55-.39 0-.19-.01-.84-.01-1.52-2.01.38-2.53-.5-2.69-.96-.09-.24-.48-.96-.82-1.15-.28-.15-.68-.52-.01-.53.63-.01 1.08.59 1.23.84.72 1.24 1.87.89 2.33.68.07-.53.28-.89.51-1.09-1.78-.21-3.64-.91-3.64-4.03 0-.89.31-1.62.82-2.19-.08-.21-.36-1.04.08-2.16 0 0 .67-.22 2.2.84A7.4 7.4 0 0 1 8 4.04c.68 0 1.36.09 2 .28 1.53-1.06 2.2-.84 2.2-.84.44 1.12.16 1.95.08 2.16.51.57.82 1.3.82 2.19 0 3.13-1.87 3.82-3.65 4.03.29.26.54.75.54 1.52 0 1.09-.01 1.97-.01 2.24 0 .21.15.47.55.39A8.06 8.06 0 0 0 16 8.2C16 3.67 12.42 0 8 0Z"
              ></path>
            </svg>
            GitHub
          </a>
        </nav>
      </header>

      <main>
        <section class="mx-auto max-w-7xl px-5 pb-24 pt-16 md:px-8 md:pb-32 md:pt-24">
          <h1
            class="display text-[clamp(2.75rem,10.5vw,8.5rem)] font-extrabold leading-[0.92] tracking-[-0.035em]"
          >
            <span class="rise block" style="--i:0">Route every</span>
            <span class="rise block" style="--i:1">x402 payment.</span>
          </h1>
          <p
            class="rise mt-8 max-w-[52ch] text-lg leading-relaxed text-secondary md:text-xl"
            style="--i:2"
          >
            One facilitator URL. The router sends each payment to <span class="text-accent"
              >PrimeV</span
            >, <span class="text-info">CDP</span> or <span class="text-primary">x402.org</span> by network.
          </p>
          <div class="rise mt-10 flex flex-wrap items-center gap-3" style="--i:3">
            <a
              href="/docs/getting-started/"
              class="press inline-flex h-12 items-center bg-accent px-6 text-sm font-semibold text-page hover:bg-accent-high"
              >Read the docs</a
            >
            <button
              type="button"
              data-copy={origin}
              aria-label={`Copy facilitator URL ${origin}`}
              class="press inline-flex h-12 max-w-full items-center gap-3 border border-edge px-5 text-sm hover:border-primary"
            >
              <span class="mono truncate text-primary">{origin}</span>
              <span data-copy-label class="shrink-0 font-semibold text-secondary">Copy</span>
            </button>
          </div>
        </section>

        {
          statements.map((statement) => (
            <section class="border-t border-line">
              <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-32">
                <h2
                  data-reveal
                  class="reveal display max-w-[17ch] text-[clamp(2.5rem,7vw,7.5rem)] font-extrabold leading-[0.95] tracking-[-0.03em] text-secondary"
                >
                  {statement.parts.map((part) =>
                    part.tone ? <span class={toneClass[part.tone]}>{part.text}</span> : part.text,
                  )}
                </h2>
                <p
                  data-reveal
                  class="reveal reveal-late mt-8 max-w-[58ch] text-lg leading-relaxed text-secondary"
                >
                  {statement.support}
                </p>
              </div>
            </section>
          ))
        }

        <section class="border-t border-line bg-band">
          <div
            class="mx-auto grid max-w-7xl grid-cols-1 gap-10 px-5 py-20 md:px-8 md:py-28 lg:grid-cols-12"
          >
            <div class="lg:col-span-4">
              <h2 class="display text-4xl font-bold leading-none tracking-[-0.02em] md:text-5xl">
                What a seller writes.
              </h2>
              <p class="mt-6 max-w-[40ch] leading-relaxed text-secondary">
                Install <code class="mono text-primary">@tunnckocore/x402-router</code> for the CDP helper.
                Everything after the facilitator is the standard x402 setup.
              </p>
              <a
                href="/docs/integration/"
                class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-accent hover:text-accent-high"
                >Integration guide <span aria-hidden="true">→</span></a
              >
            </div>
            <pre
              class="mono min-w-0 overflow-x-auto border border-line bg-code p-6 text-[13px] leading-6 text-code-text lg:col-span-8"><code set:html={highlight(sellerCode)} /></pre>
          </div>
        </section>
      </main>

      <footer class="border-t border-line">
        <div
          class="mx-auto flex max-w-7xl flex-col gap-4 px-5 py-8 text-sm text-secondary md:flex-row md:items-center md:justify-between md:px-8"
        >
          <span
            ><a
              class="text-primary underline decoration-line underline-offset-4 hover:text-accent"
              href={licenseUrl}
              rel="noreferrer external"
              target="_blank">FSL-1.1-ALv2</a
            >. Converts to Apache-2.0 after 2 years.</span
          >
          <nav class="flex flex-wrap items-center gap-x-6 gap-y-2">
            <a class="hover:text-primary" href="/docs/">Docs</a>
            <a class="hover:text-primary" href="/docs/license/">License</a>
            <a class="hover:text-primary" href={sourceUrl} rel="noreferrer external" target="_blank"
              >GitHub</a
            >
            <a
              class="mono hover:text-primary"
              href={commitHref}
              rel="noreferrer external"
              target="_blank"
              title={commit}>Build {commit.slice(0, 7)}</a
            >
            <span class="inline-flex items-center gap-2"
              ><span data-health-dot class="h-2 w-2 rounded-full bg-secondary"></span><span
                data-health-label>checking</span
              ></span
            >
          </nav>
        </div>
      </footer>
    </div>

    <script is:inline>
      // Statements reveal once on entry. Under reduced motion they are never hidden.
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const targets = [...document.querySelectorAll("[data-reveal]")];
      if (!reduce && "IntersectionObserver" in window) {
        targets.forEach((target) => target.setAttribute("data-pending", ""));
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) {return;}
              entry.target.removeAttribute("data-pending");
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.2 },
        );
        targets.forEach((target) => observer.observe(target));
      }

      const copy = document.querySelector("[data-copy]");
      const copyLabel = copy.querySelector("[data-copy-label]");
      copy.addEventListener("click", () => {
        navigator.clipboard
          .writeText(copy.dataset.copy)
          .then(() => (copyLabel.textContent = "Copied"))
          .catch(() => (copyLabel.textContent = "Copy failed"))
          .finally(() => setTimeout(() => (copyLabel.textContent = "Copy"), 2000));
      });

      const dot = document.querySelector("[data-health-dot]");
      const label = document.querySelector("[data-health-label]");
      fetch("/health")
        .then((response) => (response.ok ? response.json() : Promise.reject()))
        .then((health) => {
          dot.className = "h-2 w-2 rounded-full bg-accent";
          label.textContent = `Online, build ${String(health.commit).slice(0, 7)}`;
        })
        .catch(() => {
          dot.className = "h-2 w-2 rounded-full bg-danger";
          label.textContent = "Offline";
        });
    </script>

    <style>
      .manifesto {
        font-family: "General Sans", ui-sans-serif, system-ui, sans-serif;
      }
      .display {
        font-family: "Cabinet Grotesk", "General Sans", ui-sans-serif, system-ui, sans-serif;
        text-wrap: balance;
      }
      .manifesto :global(.mono),
      .manifesto :global(code),
      .manifesto :global(pre) {
        font-family: "Geist Mono", ui-monospace, monospace;
      }
      .press:active {
        transform: scale(0.97);
      }
      @media (prefers-reduced-motion: no-preference) {
        .press {
          transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
        }
        .rise {
          animation: manifesto-rise 300ms cubic-bezier(0.23, 1, 0.32, 1) both;
          animation-delay: calc(var(--i, 0) * 60ms);
        }
        .reveal {
          transition:
            opacity 300ms cubic-bezier(0.23, 1, 0.32, 1),
            transform 300ms cubic-bezier(0.23, 1, 0.32, 1);
        }
        .reveal-late {
          transition-delay: 60ms;
        }
        .reveal[data-pending] {
          opacity: 0;
          transform: translateY(12px);
        }
      }
      @keyframes manifesto-rise {
        from {
          opacity: 0;
          transform: translateY(12px);
        }
      }
    </style>
  </body>
</html>

#!/bin/sh
# Format, lint, and type-check the packages with staged or unstaged changes, TypeScript and
# Solidity alike; turbo compares the working tree against HEAD. The fixers may rewrite files; the
# commit stops so the developer can review and stage those changes. Nothing is staged on their
# behalf, so partially staged files keep their unstaged hunks out of the commit.
before=$(git diff | git hash-object --stdin)
TURBO_SCM_BASE=HEAD pnpm exec turbo run check --affected || exit 1
after=$(git diff | git hash-object --stdin)
if [ "$before" != "$after" ]; then
  echo "pre-commit: the check changed files; review them, stage them, and commit again" >&2
  exit 1
fi

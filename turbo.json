{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "pnpm-workspace.yaml",
    "tsconfig.json",
    "oxlint.config.ts",
    "oxfmt.config.ts",
    "patches/**"
  ],
  "agentGuidance": false,
  "concurrency": "4",
  "tasks": {
    "//#check": {
      "inputs": ["*.md", "*.json", "*.ts", ".changeset/**", "scripts/**", ".zed/**", ".rwx/**"],
      "outputs": []
    },
    "check": {
      "outputs": []
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.{yml,yaml}"],
      "outputs": []
    },
    "fmt": {
      "outputs": []
    },
    "lint": {
      "dependsOn": ["fmt"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"],
      "inputs": ["$TURBO_DEFAULT$", "!test/**"],
      "env": ["COMMIT_SHA"]
    },
    "deploy:nightly": {
      "cache": false,
      "passThroughEnv": [
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_API_TOKEN",
        "BADGES_DEPOT_TOKEN",
        "COMMIT_SHA",
        "VLT_READ_TOKEN",
        "VLT_UPSTREAM_URL",
        "VLT_WRITE_TOKEN",
        "BETTER_AUTH_SECRET",
        "IDENTIFIER_SECRET",
        "RATE_LIMIT_SECRET",
        "ENCRYPTION_SECRETS",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "TWITTER_CLIENT_ID",
        "TWITTER_CLIENT_SECRET"
      ]
    },
    "deploy:prod": {
      "cache": false,
      "passThroughEnv": [
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_API_TOKEN",
        "COMMIT_SHA",
        "BETTER_AUTH_SECRET",
        "IDENTIFIER_SECRET",
        "RATE_LIMIT_SECRET",
        "ENCRYPTION_SECRETS",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "TWITTER_CLIENT_ID",
        "TWITTER_CLIENT_SECRET"
      ]
    }
  }
}

{
  "name": "triad-better-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "check": "vp check",
    "build": "vp build",
    "deploy": "vp exec wrangler deploy",
    "db:local": "vp exec wrangler d1 migrations apply triad-better-auth --local",
    "db:remote": "vp exec wrangler d1 migrations apply triad-better-auth --remote",
    "auth:schema": "vp exec tsx scripts/generate-schema.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.0-rc.1",
    "@better-auth/oauth-provider": "1.7.0-rc.1",
    "better-auth": "1.7.0-rc.1",
    "hono": "^4.10.8",
    "kysely": "0.28.17"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "@cloudflare/workers-types": "^5.20260713.1",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.11.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite-plus": "0.2.4",
    "wrangler": "^4.110.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  },
  "patchedDependencies": {
    "@better-auth/oauth-provider@1.7.0-rc.1": "patches/@better-auth%2Foauth-provider@1.7.0-rc.1.patch"
  }
}

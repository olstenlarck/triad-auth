{
  "name": "monarch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "check": "ultracite fix --type-aware --type-check AGENTS.md LICENSE.md package.json tsconfig.json turbo.json oxfmt.config.ts oxlint.config.ts .changeset .depot .github .zed",
    "packages:publish": "turbo run build --filter='./packages/*' && changeset publish",
    "packages:version": "pnpm install --lockfile-only --ignore-scripts --no-frozen-lockfile && turbo run check test --filter='!./solidity/*' && GITHUB_TOKEN=\"${GITHUB_TOKEN:-$(gh auth token)}\" changeset version",
    "prepare": "case \"${CI:-}\" in \"\"|0|false|FALSE|no) git config core.hooksPath .githooks ;; esac",
    "solidity:build": "turbo run build --filter='./solidity/*'",
    "solidity:check": "turbo run check --filter='./solidity/*'",
    "solidity:fmt": "turbo run fmt --filter='./solidity/*'",
    "solidity:lint": "turbo run lint --filter='./solidity/*'",
    "solidity:test": "turbo run test --filter='./solidity/*'",
    "solidity:test:fresh": "turbo run test --filter='./solidity/*' --force"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@cloudflare/workers-types": "catalog:types",
    "@types/bun": "catalog:types",
    "@types/node": "catalog:types",
    "@vitest/coverage-v8": "catalog:",
    "cf": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "socket": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:types",
    "ultracite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.21.0"
}
